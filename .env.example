# Configurare pentru Asistentul RAG - Cafenea Matinal Ploiesti

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://openrouter.ai/api/v1
GROQ_MODEL=openai/gpt-oss-20b:free

# Directorul de date locala
DATA_DIR=./data

# URL-uri pentru RAG (separati prin ;)
# Adaugati link-urile site-urilor de unde vor fi extrase informatiile
# Exemplu de site-uri posibile:
# - Site propriu cafenea (daca exista)
# - Pagina Facebook Matinal Ploiesti
# - Profiluri pe platforme de review (Google Maps, Tripadvisor)
# - Bloguri cu informatii despre cafeneaua Matinal
WEB_URLS=https://example.com/matinal;https://facebook.com/cafenea-matinal

# Dimensiunea embedding-urilor HashingVectorizer
EMBEDDING_N_FEATURES=2048
